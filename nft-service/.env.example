# Solana RPC endpoint (mainnet-beta for production)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Server wallet keypair file path (JSON array of 64 bytes)
# Generate with: npm run generate-keypair
WALLET_KEYPAIR_PATH=./wallet-keypair.json

# PhotoLynk shared Merkle Tree for cNFTs (same as mobile apps)
MERKLE_TREE=7qSKB5q1JMmsGx2cHzAJPxvjzXCbAfpWNDTKDM3tSunS

# Commission wallet (receives minting fees in SOL)
COMMISSION_WALLET=HttTZkUG8xn5A1uJPjRDJqqufdwvHmNQroEGmST8iimU

# Pinata IPFS (primary storage)
PINATA_JWT=your_pinata_jwt_here

# NFT.storage (fallback)
NFT_STORAGE_API_KEY=

# Akord Arweave (permanent storage option)
AKORD_API_KEY=

# Your fee markup on top of Solana costs (in USD)
# This is what you earn per NFT mint on top of network fees
APP_FEE_USD=0.50

# Promo pricing (first 30 days)
PROMO_FEE_USD=0.05
PROMO_START_DATE=2026-01-27T00:00:00Z
PROMO_DURATION_DAYS=30

# SQLite database path for user balances
DB_PATH=./data/nft-service.db

# Port (if running standalone; otherwise integrated into main server)
PORT=3100
